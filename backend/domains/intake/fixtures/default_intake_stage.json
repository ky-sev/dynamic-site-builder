{
  "version": 1,
  "title": "Deal intake",
  "description": "Capture the essential details for a new deal.",
  "fields": [
    {
      "key": "customerName",
      "label": "Customer name",
      "type": "text",
      "required": true,
      "reportable": false
    },
    {
      "key": "dealName",
      "label": "Deal name",
      "type": "text",
      "required": true,
      "reportable": true
    },
    {
      "key": "dealType",
      "label": "Deal type",
      "type": "dropdown",
      "required": true,
      "options": [
        "Acquisition",
        "Partnership",
        "Renewal"
      ],
      "reportable": true
    }
  ]
}
